# Cruxial — environment variables reference
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in only what you need:  cp .env.example .env
#
# The SDK itself needs NO keys. These are only for (a) the example scripts in
# examples/ that call a real LLM, and (b) optional Cruxial config overrides.
# Nothing here is read automatically — `export` the vars, or load this file
# with your shell / direnv / python-dotenv before running an example.
#
# Quick check that the SDK works with zero config:  cruxial demo
# ---------------------------------------------------------------------------


# ── LLM provider keys (only for examples/ that hit a live model) ────────────

# OpenAI — used by examples/openai_demo.py and the provider-agnostic
# examples/demo_suite.py. This is the most common path; if you only set one
# provider, set this one.
OPENAI_API_KEY=sk-...

# Anthropic — used by examples/anthropic_demo.py
ANTHROPIC_API_KEY=sk-ant-...

# Azure OpenAI — used by the azure_*.py examples (the original benchmark runs).
# All three of these are required together for the Azure examples; the API
# version is optional and defaults to 2024-08-01-preview.
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-08-01-preview


# ── Model selection for the simple single-prompt demos (optional) ───────────

# Override the model used by examples/openai_demo.py (default: gpt-4o-mini)
# CRUXIAL_OPENAI_MODEL=gpt-4o-mini

# Override the model used by examples/anthropic_demo.py (default: claude-3-5-sonnet-latest)
# CRUXIAL_ANTHROPIC_MODEL=claude-3-5-sonnet-latest


# ── Cruxial SDK config (optional — sensible defaults if unset) ──────────────

# Where the local telemetry SQLite file lives. If unset, Cruxial resolves:
#   1) this CRUXIAL_DB_PATH, else
#   2) ./.cruxial/telemetry.sqlite (walked up from cwd to the project root), else
#   3) ~/.cruxial/telemetry.sqlite
# Run `cruxial diagnostic` to see which path is in effect.
# CRUXIAL_DB_PATH=/absolute/path/to/telemetry.sqlite

# Comma-separated MCP servers for examples/azure_mcp_suite.py (optional; the
# script ships with a default server set if unset).
# CRUXIAL_MCP_SERVERS=filesystem,memory,time
